                  "id": "4be5e46c-8c03-eca9-046c-61c6fbefad53"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Iyer: Good\nmorning. Today we\nintegrate.",
                      "Emotionally and\nmathematically."
                    ],
                    "avatarId": ""
                  },
                  "id": "befcf46e-2100-5b59-b805-4849c6ffd879"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Garvita: (to you)\nI sat in the back\nso I can leave",
                      "first. Strategy."
                    ],
                    "avatarId": ""
                  },
                  "id": "9e69c783-f58b-9b2f-b5aa-957a2b7a56aa"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: That's\nnot strategy.\nThat's an exit."
                    ],
                    "avatarId": ""
                  },
                  "id": "6446114b-afd3-d7c1-5162-bb0157aa1ea5"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Iyer: The\nintegral of e^x dx\nis...?"
                    ],
                    "avatarId": ""
                  },
                  "id": "9789d5f1-300e-635d-8e0b-01ea7d7a11fc"
                },
                {
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "119",
                    "items": 3,
                    "cancelOnLastOption": false,
                    "cancelOnB": false,
                    "layout": "dialogue",
                    "option1": "e^x + C",
                    "option2": "x e^x",
                    "option3": "e"
                  },
                  "id": "e8da8f05-8f49-8816-5f2f-7a56102a6f44"
                },
                {
                  "command": "EVENT_IF",
                  "args": {
                    "condition": {
                      "type": "eq",
                      "valueA": {
                        "type": "variable",
                        "value": "119"
                      },
                      "valueB": {
                        "type": "number",
                        "value": 1
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Iyer: Yes.\nNever forget the +\nC.",
                            "It is the C of\ncompassion."
                          ],
                          "avatarId": ""
                        },
                        "id": "2710888e-b0ea-82e7-17b1-d180e2c50b7b"
                      },
                      {
                        "command": "EVENT_INC_VALUE",
                        "args": {
                          "variable": "139"
                        },
                        "id": "ce662507-8d33-b98d-8d71-4f7103791dd1"
                      }
                    ],
                    "false": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Iyer: Close.\nPainfully close.\nWrong."
                          ],
                          "avatarId": ""
                        },
                        "id": "d2710d34-2ad7-984d-3c31-4f5a8df97acd"
                      }
                    ]
                  },
                  "id": "62bc67a1-4489-0b0d-a37c-cacaf4f59844"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Iyer: Rank\nof the 3x3\nidentity matrix?"
                    ],
                    "avatarId": ""
                  },
                  "id": "0417482e-c025-109c-4ff6-d076981f4acd"
                },
                {
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "119",
                    "items": 3,
                    "cancelOnLastOption": false,
                    "cancelOnB": false,
                    "layout": "dialogue",
                    "option1": "0",
                    "option2": "1",
                    "option3": "3"
                  },
                  "id": "8d174e3f-2698-c8ae-5c17-29d72fa492dd"
                },
                {
                  "command": "EVENT_IF",
                  "args": {
                    "condition": {
                      "type": "eq",
                      "valueA": {
                        "type": "variable",
                        "value": "119"
                      },
                      "valueB": {
                        "type": "number",
                        "value": 3
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Iyer: Three!",
                            "Full rank, like\nyour attendance\nshould be."
                          ],
                          "avatarId": ""
                        },
                        "id": "9dae43dd-6042-bcc3-8076-97aadd65e27b"
                      },
                      {
                        "command": "EVENT_INC_VALUE",
                        "args": {
                          "variable": "139"
                        },
                        "id": "c7651b61-4abe-2b8c-2c42-1870e48a0e54"
                      }
                    ],
                    "false": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Iyer:\nIdentity has full\nrank.",
                            "Like your\nconfidence."
                          ],
                          "avatarId": ""
                        },
                        "id": "798609ea-35a4-b0ec-c5ca-5e7f13beb90e"
                      }
                    ]
                  },
                  "id": "5a430f74-4555-f3df-3e07-05daa75ec28c"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Iyer:\nDivyansh says 1/0\n= 'infinity,",
                      "easy'. Is he..."
                    ],
                    "avatarId": ""
                  },
                  "id": "d3433077-7182-9410-cdbb-50b76c5a8b46"
                },
                {
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "119",
                    "items": 3,
                    "cancelOnLastOption": false,
                    "cancelOnB": false,
                    "layout": "dialogue",
                    "option1": "right",
                    "option2": "undefined",
                    "option3": "Divyansh"
                  },
                  "id": "56400907-e4e6-0f10-7973-818919c8db3f"
                },
                {
                  "command": "EVENT_IF",
                  "args": {
                    "condition": {
                      "type": "eq",
                      "valueA": {
                        "type": "variable",
                        "value": "119"
                      },
                      "valueB": {
                        "type": "number",
                        "value": 2
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Iyer:\nUndefined. Much\nlike his plans."
                          ],
                          "avatarId": ""
                        },
                        "id": "83cd93dd-f2fa-0615-7ff3-3f8fddb99145"
                      },
                      {
                        "command": "EVENT_INC_VALUE",
                        "args": {
                          "variable": "139"
                        },
                        "id": "8a742132-2728-c4ff-0251-3c3c22e3fddd"
                      }
                    ],
                    "false": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Iyer:\nMathematically,\nDivyansh is a",
                            "constant. Not a\ncorrect one."
                          ],
                          "avatarId": ""
                        },
                        "id": "20908087-0ab4-c1b3-31e8-ee00db1d0f33"
                      }
                    ]
                  },
                  "id": "a4662d4b-ab6d-a5dc-2b06-156f58874f10"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: Ma'am, I\ndid all three in\nmy head.",
                      "My head just\ndoesn't have a\npen."
                    ],
                    "avatarId": ""
                  },
                  "id": "be9411cf-5237-5087-ad77-284d5fd40d4c"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Iyer: Then\nlend your head a\npen.",
                      "Class dismissed."
                    ],
                    "avatarId": ""
                  },
                  "id": "c60fcbea-fa84-e719-88a7-794342bc6cf8"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Garvita: Cricket\nmatch after class!\nHostel vs. Hostel.",
                      "Ground near AB3."
                    ],
                    "avatarId": ""
                  },
                  "id": "a00106ca-92da-8164-6844-6335ca5e86c5"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: I will\nhit a six. First\nball.",
                      "Write it down."
                    ],
                    "avatarId": ""
                  },
                  "id": "f9f8e7ce-6533-ab10-2878-4126a6d8de97"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: Writing\nit down. For\nevidence."
                    ],
                    "avatarId": ""
                  },
                  "id": "26b23ef6-5892-290d-3c76-d40218482d6c"
                },
