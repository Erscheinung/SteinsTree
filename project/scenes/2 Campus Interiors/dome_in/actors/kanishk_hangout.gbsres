              "true": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: This\nlibrary has 14\nexits. I counted.",
                      "Habit.",
                      "Kanishk: I plan\neverything.",
                      "Semester, meals,\nwhich stairs are\nfastest.",
                      "Kanishk: If you\nhave a plan,\nnothing can",
                      "surprise you.\nThat's the theory."
                    ],
                    "avatarId": ""
                  },
                  "id": "3bf2ecb5-9e37-4df9-52a6-754e68611586"
                }
              ],
              "false": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: Chess?\nYou lost in nine\nmoves. Good.",
                      "You'll lose in ten\nnext time.",
                      "Kanishk: My dad\nsays I calculate\npeople like",
                      "pieces. I don't.\nMostly.",
                      "Kanishk: There's\nalways one\nvariable you can't",
                      "plan for. I hate\nthat variable."
                    ],
                    "avatarId": ""
                  },
                  "id": "22149554-32dd-adf2-bf30-c1485bf8de37"
                }
              ]
