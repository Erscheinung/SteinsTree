                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dr. Mehra: Goggles\nON.",
                      "Mr. Parag, goggles\nare not a\nheadband."
                    ],
                    "avatarId": ""
                  },
                  "id": "d643e6a8-bab8-e0e1-9961-aae0cfff662e"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Parag: Sir, it's\naerodynamic."
                    ],
                    "avatarId": ""
                  },
                  "id": "2ed623f7-cdae-9de6-f6ea-4e77a676c77f"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dr. Mehra:\nTitration.",
                      "Burette, pipette,\nflask.",
                      "Indicator turns\npink at the end\npoint."
                    ],
                    "avatarId": ""
                  },
                  "id": "faf55087-87cd-a118-e441-a12a91857c5b"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dr. Mehra: Step\none. Diluting the\nacid.",
                      "What goes into\nwhat?"
                    ],
                    "avatarId": ""
                  },
                  "id": "da6651c6-6a60-b71f-a3f3-72d1541cd9f6"
                },
                {
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "119",
                    "items": 3,
                    "cancelOnLastOption": false,
                    "cancelOnB": false,
                    "layout": "dialogue",
                    "option1": "Water into acid",
                    "option2": "Acid into water",
                    "option3": "Mix very fast"
                  },
                  "id": "b63fe77c-eaed-d356-41e7-1884e38997e3"
                },
                {
                  "command": "EVENT_IF",
