                      "valueB": {
                        "type": "number",
                        "value": 2
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Dr. Mehra:\nCorrect! Acid into\nwater. Always.",
                            "Like my coffee\ninto me."
