            "children": {
              "true": [
                {
                  "command": "EVENT_COMMENT",
                  "args": {
                    "text": "DAY 1 - DINNER AT THE QUESS MESS: meet the gang",
                    "__collapse": false
                  },
                  "id": "0e579f89-388e-8fc3-81b2-2736db14e9a6"
                },
                {
                  "command": "EVENT_ACTOR_SET_POSITION",
                  "args": {
                    "actorId": "player",
                    "x": {
                      "type": "number",
                      "value": 12
                    },
                    "y": {
                      "type": "number",
                      "value": 14
                    }
                  },
                  "id": "d6bf226b-13d7-bd76-6b08-bf3129b9b38d"
                },
                {
                  "command": "EVENT_ACTOR_MOVE_TO",
                  "args": {
                    "actorId": "player",
                    "x": {
                      "type": "number",
                      "value": 12
                    },
                    "y": {
                      "type": "number",
                      "value": 11
                    },
                    "collideWith": [],
                    "moveType": "horizontal"
                  },
                  "id": "a56a6f88-4015-2d5e-9606-f97e56b1f2ba"
                },
                {
                  "command": "EVENT_ACTOR_SET_DIRECTION",
                  "args": {
                    "actorId": "player",
                    "direction": {
                      "type": "direction",
                      "value": "up"
                    }
                  },
                  "id": "e02d7f26-a03a-bf8c-3a64-d4c88203e624"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mess Bhaiya: Rajma\nchawal. Again.\nIt's Monday.",
                      "It's always rajma\non Monday."
                    ],
                    "avatarId": ""
                  },
                  "id": "3f57e297-9739-f4f4-d211-865accdfb71c"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: Okay.\nFormal\nintroductions.",
                      "This is our new\nmember."
                    ],
                    "avatarId": ""
                  },
                  "id": "2b1f80a3-730c-bc3e-32c4-49422f70fbda"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh:\nDivyansh.",
                      "Future topper,\nfuture CEO, future\ngym guy.",
                      "Divyansh: Starting\nMonday. Not this\none."
                    ],
                    "avatarId": ""
                  },
                  "id": "d7a4fbe9-e758-62ad-076e-79f6bb5caacb"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Parag: Parag. I\nbuild stuff.",
                      "Mostly stuff that\nworks on the\nsecond try."
                    ],
                    "avatarId": ""
                  },
                  "id": "0ccbb5c4-dcaa-c041-0033-ab3348452c03"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Garvita: Garvita.\nI run. Stairs,\nledges, anything.",
                      "Don't race me."
                    ],
                    "avatarId": ""
                  },
                  "id": "5a606539-4c76-379f-6344-968837a102a2"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: I could\nbeat her.",
                      "I just don't want\nto embarrass her."
                    ],
                    "avatarId": ""
                  },
                  "id": "2c3f862c-8a51-b7fd-ff62-942745c4bcd1"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Garvita: Race me\nto the counter\nthen."
                    ],
                    "avatarId": ""
                  },
                  "id": "03773d69-5521-9a47-d639-e7208547271a"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: ...after\ndinner. Digestion\nis important."
                    ],
                    "avatarId": ""
                  },
                  "id": "bfda128f-de18-5d54-3a0d-f1d138d07272"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: And\nAnshuman. He's...\nsomewhere."
                    ],
                    "avatarId": ""
                  },
                  "id": "3a04b70b-6000-796a-10ca-4a267ff3cfd9"
                },
                {
                  "command": "EVENT_ACTOR_MOVE_TO",
                  "args": {
                    "actorId": "d1a2a2d8-8109-50c5-8a90-80f65e7e1c60",
                    "x": {
                      "type": "number",
                      "value": 11
                    },
                    "y": {
                      "type": "number",
                      "value": 13
                    },
                    "collideWith": [],
                    "moveType": "horizontal"
                  },
                  "id": "7f6cdc0f-5824-2211-7892-e4669158f6c2"
                },
                {
                  "command": "EVENT_ACTOR_SET_DIRECTION",
                  "args": {
                    "actorId": "player",
                    "direction": {
                      "type": "direction",
                      "value": "down"
                    }
                  },
                  "id": "b3e9d6da-8153-cb34-0840-f8f3a18537a0"
                },
                {
                  "command": "EVENT_ACTOR_EMOTE",
                  "args": {
                    "actorId": "player",
                    "emoteId": "9b053db2-c927-48e9-adaa-2d3deaa0b220"
                  },
                  "id": "a36b53bc-d5b2-33c6-374e-63b298390d4c"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Anshuman: Behind\nyou. Since the\nrajma."
                    ],
                    "avatarId": ""
                  },
                  "id": "b956d767-7f3d-e2d4-1455-e9fb8a8c1cf4"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "You: HOW."
                    ],
                    "avatarId": ""
                  },
                  "id": "1e32ee6a-9e67-4330-0a51-6f94559491f2"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Anshuman:\nPractice. Nobody\nnotices the guy",
                      "who doesn't want\nto be noticed."
                    ],
                    "avatarId": ""
                  },
                  "id": "2e456783-5bb9-2647-c2d1-47ce22fe0247"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: Kanishk\nskipped. Library.",
                      "He's 'planning the\nsemester like a\ncampaign'."
                    ],
                    "avatarId": ""
                  },
                  "id": "bae0789e-2390-3e52-a8ea-f1f18ab11174"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: Okay,\nbill. I'll pay.\nDefinitely.",
                      "Let me just...\nfind... my\nwallet..."
                    ],
                    "avatarId": ""
                  },
                  "id": "9eda9e09-8eba-f015-ceb8-1ee6e3af4b64"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Parag: Fifty\nrupees, Kanishk\ncalled it.",
                      "He's not even here\nand he won."
                    ],
                    "avatarId": ""
                  },
                  "id": "09a2d809-aabd-f7cb-8736-71dd77675c93"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: Free\nevening! Hang out\nwith someone.",
                      "They're around\ncampus.",
                      "Mayank: Divyansh:\nNBC. Parag: the\navenue.",
                      "Anshuman: the\nscrub trail.",
                      "Garvita: cricket\nground.",
                      "Mayank: Kanishk:\nthe Dome library.\nMe: B7 courts."
                    ],
                    "avatarId": ""
                  },
                  "id": "acdccda0-45e4-af47-a627-5a1da8b591e4"
                },
                {
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "101",
                    "value": {
