                  "id": "c627e8c7-b997-33a0-dcb5-82cdafc01bca"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Rao: Roll\nnumber 47? ...47?",
                      "Proxy is a crime,\nbeta. Present\nyourself."
                    ],
                    "avatarId": ""
                  },
                  "id": "9d47e8d8-2969-6907-b12d-0bd9fbb8462f"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "You: Present, sir!"
                    ],
                    "avatarId": ""
                  },
                  "id": "526990a0-8325-2d0b-c285-eb794d0777bd"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Rao: Today:\nthe dual nature of\nlight.",
                      "Is it a wave? Is\nit a particle?"
                    ],
                    "avatarId": ""
                  },
                  "id": "5b3edc7c-717f-475d-789d-5e9d0a3ba9e8"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh:\n(whispering) Sir\ndoesn't know.",
                      "I'll explain it to\nhim after class."
                    ],
                    "avatarId": ""
                  },
                  "id": "c605e954-6050-46d0-6c6e-f43d403791c1"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: (not\nlooking back) You\nwill not."
                    ],
                    "avatarId": ""
                  },
                  "id": "13902058-520a-4046-61c1-17e30adedd6f"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Rao: Pop\nquiz! Three\nquestions.",
                      "Hands off your\nphones, I can see\nthe glow."
                    ],
                    "avatarId": ""
                  },
                  "id": "deaff159-98ee-1f8b-8fe1-18e75ce13cbe"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Rao:\nPlanck's constant\nhas units of...?"
                    ],
                    "avatarId": ""
                  },
                  "id": "04c04f31-c72a-d85c-538c-e6fa2ee17b2d"
                },
                {
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "119",
                    "items": 3,
                    "cancelOnLastOption": false,
                    "cancelOnB": false,
                    "layout": "dialogue",
                    "option1": "J s",
                    "option2": "kg/m",
                    "option3": "vibes"
                  },
                  "id": "a10b167e-a1bc-605d-31c2-7e5489fb5356"
                },
                {
                  "command": "EVENT_IF",
                  "args": {
                    "condition": {
                      "type": "eq",
                      "valueA": {
                        "type": "variable",
                        "value": "119"
                      },
                      "valueB": {
                        "type": "number",
                        "value": 1
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Rao:\nCorrect! Joule-\nsecond.",
                            "Someone attended\nJEE classes."
                          ],
                          "avatarId": ""
                        },
                        "id": "1446bc2b-ce80-982c-9852-e7d43dfa5005"
                      },
                      {
                        "command": "EVENT_INC_VALUE",
                        "args": {
                          "variable": "139"
                        },
                        "id": "a96eff3e-82f6-5222-c0d2-fcd8003bffb7"
                      }
                    ],
                    "false": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Rao: Vibes\nis not an SI unit.\nYet."
                          ],
                          "avatarId": ""
                        },
                        "id": "c99d3827-e7ee-9363-17c7-f7fca6b2e16b"
                      }
                    ]
                  },
                  "id": "7eb2920f-ef70-8978-5c91-39d8e6fefcfa"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Rao: Light\nbehaves as...?"
                    ],
                    "avatarId": ""
                  },
                  "id": "6f9e4bb7-9c09-bb29-411a-75dbc753aeba"
                },
                {
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "119",
                    "items": 3,
                    "cancelOnLastOption": false,
                    "cancelOnB": false,
                    "layout": "dialogue",
                    "option1": "only a wave",
                    "option2": "only a particle",
                    "option3": "both"
                  },
                  "id": "b560daab-60da-2ec4-a0e3-61c38119b38b"
                },
                {
                  "command": "EVENT_IF",
                  "args": {
                    "condition": {
                      "type": "eq",
                      "valueA": {
                        "type": "variable",
                        "value": "119"
                      },
                      "valueB": {
                        "type": "number",
                        "value": 3
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Rao: Both!",
                            "Like you all: a\nwave at 9 AM, a\nparticle at 9 PM."
                          ],
                          "avatarId": ""
                        },
                        "id": "68804c53-d7bf-23f4-ce1b-8c30ebbc7c90"
                      },
                      {
                        "command": "EVENT_INC_VALUE",
                        "args": {
                          "variable": "139"
                        },
                        "id": "0cabd016-958e-3a67-db7f-71eefc970a47"
                      }
                    ],
                    "false": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Rao: Half\nmarks for\nconfidence.",
                            "Zero for physics."
                          ],
                          "avatarId": ""
                        },
                        "id": "866b1f14-0faa-cbc4-ef30-12b6be39c74e"
                      }
                    ]
                  },
                  "id": "3b911009-8964-24b0-4d07-5b7482e0ba74"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Prof. Rao: Photon\nenergy rises if\nwavelength..."
