                        "type": "variable",
                        "value": "119"
                      },
                      "valueB": {
                        "type": "number",
                        "value": 2
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Rao: Shorter\nwavelength, more\nenergy.",
                            "Like this class."
                          ],
                          "avatarId": ""
                        },
                        "id": "dbfe5d79-3849-cd61-57c8-a7a47596237a"
                      },
                      {
                        "command": "EVENT_INC_VALUE",
                        "args": {
                          "variable": "139"
                        },
                        "id": "80296cc9-f026-8b4e-8459-efe24c38f30d"
                      }
                    ],
                    "false": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Prof. Rao: It may\ngo home. You may\nnot."
                          ],
                          "avatarId": ""
                        },
                        "id": "5ff7c3f7-0e1d-9185-0245-58e9d52d9484"
                      }
                    ]
                  },
                  "id": "857d1924-3341-610b-ee5a-0266eb8bfc95"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: Easy. I\nwould have got all\nthree.",
                      "I was just letting\nyou have them."
                    ],
                    "avatarId": ""
                  },
                  "id": "8181cc04-1ac9-eb1e-a3e3-7863e383a657"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: (quietly)\nHe got zero last\nweek.",
                      "In the test about\nhis own name."
                    ],
                    "avatarId": ""
                  },
                  "id": "741be887-b24d-d387-24ba-6ace52c0ca66"
                },
