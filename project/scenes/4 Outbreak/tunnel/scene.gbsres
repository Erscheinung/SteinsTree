    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "ANSHUMAN'S GOODBYE - he becomes what he always was: unseen, and kind",
        "__collapse": false
      },
      "id": "a7572b3f-433a-888d-f7b4-2ea820639888"
    },
    {
      "command": "EVENT_ACTOR_SET_POSITION",
      "args": {
