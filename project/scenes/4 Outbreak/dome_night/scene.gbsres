    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "MAYANK - the last friend, the first question",
        "__collapse": false
      },
      "id": "895e045a-4fc3-9834-49e8-af443cf4a6a3"
    },
    {
      "command": "EVENT_ACTOR_SET_POSITION",
      "args": {
        "actorId": "player",
        "x": {
          "type": "number",
          "value": 13
        },
        "y": {
          "type": "number",
          "value": 13
        }
      },
      "id": "ae493f1b-409f-782d-0178-60b17ed36ca3"
    },
    {
      "command": "EVENT_ACTOR_SET_DIRECTION",
      "args": {
        "actorId": "player",
        "direction": {
          "type": "direction",
          "value": "up"
        }
      },
      "id": "d16e84b2-b33d-e68c-07b8-3db8d1129966"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: You made\nit. I took the\nlong way.",
          "Through the\nlibrary. Sat down\nfor a bit."
        ],
        "avatarId": ""
      },
      "id": "631d970f-0c0a-c8ef-4028-c4325602b466"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "You: The PA. The\nphone. We can\ncall--"
        ],
        "avatarId": ""
      },
      "id": "1590428a-47b5-1e2f-0c62-ad2b029609a4"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: Already\ndid. Nobody's\ncoming tonight."
        ],
        "avatarId": ""
      },
      "id": "50459252-87f9-e7c3-cc0a-81a08c6649c3"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: Hey. Look\nat the ceiling.\nThe dome.",
          "It's beautiful\nfrom underneath."
        ],
        "avatarId": ""
      },
      "id": "3c0d7951-c5ab-e2de-b80c-e47ac920d566"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: I got bit\non the staircase.\nWhen Divyansh ran.",
          "It's fine. It\ndoesn't hurt much."
        ],
        "avatarId": ""
      },
      "id": "baa676df-16fb-f693-37f9-6361a7b1d430"
    },
    {
      "command": "EVENT_CHOICE",
      "args": {
        "variable": "119",
        "trueText": "No. No no no.",
        "falseText": "Sit with him"
      },
      "id": "c1cf0a90-c7a7-d712-dbbd-b2af7f391833"
    },
    {
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "eq",
          "valueA": {
            "type": "variable",
            "value": "119"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        },
        "__collapseElse": false
      },
      "children": {
        "true": [
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Mayank: Yeah.\nSame."
              ],
              "avatarId": ""
            },
            "id": "ea192320-19f5-a575-8f44-7b95a3410d75"
          },
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Mayank: Sit with\nme anyway."
              ],
              "avatarId": ""
            },
            "id": "51612121-c54d-d63c-35a8-ec7a2bd1d50c"
          }
        ],
        "false": [
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Mayank: Thanks."
              ],
              "avatarId": ""
            },
            "id": "3e97ed38-3045-f1d4-19ed-f859d3f67f8a"
          }
        ]
      },
      "id": "6307658f-2b9a-82fe-fdea-d9ebebaa8023"
    },
    {
      "command": "EVENT_VARIABLE_MATH",
      "args": {
        "vectorX": "122",
        "operation": "add",
        "other": "val",
        "value": "1",
        "minValue": "0",
        "maxValue": "0",
        "clamp": true
      },
      "id": "0f0fa788-e5e8-9411-0598-f1e0f4d6e1df"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: You never\nanswered me.\nBehind B7.",
          "Why did you come\nhere?"
        ],
        "avatarId": ""
      },
      "id": "9926f7ab-630a-24ef-1bbd-323b860a03bb"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "You: I... I don't\nknow."
        ],
        "avatarId": ""
      },
      "id": "0487281b-f314-bd72-bb27-685389e0c385"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: Then go\nfind out.",
          "I think it's all\nstill in there.",
          "Everything before\nthis."
        ],
        "avatarId": ""
      },
      "id": "c3cead03-298f-75c6-5ac6-e3383c31848f"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: My nani\nsaid life is a\ncircle.",
          "So this isn't the\nend."
        ],
        "avatarId": ""
      },
      "id": "ac690934-df48-bdf8-aa82-01a811894483"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mayank: It's\njust... the\nmiddle."
        ],
        "avatarId": ""
      },
      "id": "b9ad7c57-537e-4156-d707-4492df3fb69d"
    },
