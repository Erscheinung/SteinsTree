                            {
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Mayank: Bro!\nPhysics! AB1! Nine\no'clock!",
                                  "Mayank: Prof. Rao\ntakes attendance\nlike it's the",
                                  "national census."
                                ],
                                "avatarId": ""
                              }
                            },
                            {
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "You: It's 8:52."
                                ],
                                "avatarId": ""
                              }
                            },
                            {
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Mayank: Then RUN.",
                                  "Through the hostel\ngate, down the\nunderpass.",
                                  "AB1 is right\nthere."
                                ],
                                "avatarId": ""
                              }
                            },
                            {
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "(Press START any\ntime for the menu.\nThe !",
                                  "on the campus map\nis where you need\nto be.)"
                                ],
                                "avatarId": ""
                              }
                            }
                          ],
