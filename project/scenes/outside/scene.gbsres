                            {
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Mayank: Bro!\nPhysics! AB1! Nine\no'clock!",
                                  "Mayank: Prof. Rao\ntakes attendance\nlike it's the",
                                  "national census."
                                ],
                                "avatarId": ""
                              },
                              "id": "92662c4c-c94b-c79b-57d1-e48a7f45472f"
                            },
