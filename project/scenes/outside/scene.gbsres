                                ],
                                "avatarId": ""
                              },
                              "id": "aa768e12-2228-1426-5882-18aee4b4717f"
                            },
                            {
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Mayank: Then RUN.",
                                  "Through the hostel\ngate, down the\nunderpass.",
                                  "AB1 is right\nthere."
                                ],
                                "avatarId": ""
                              },
                              "id": "9f556643-8014-21d5-c138-f7e91a80f4f3"
                            },
                            {
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "(Press START any\ntime for the menu.\nThe !",
                                  "on the campus map\nis where you need\nto be.)"
                                ],
                                "avatarId": ""
                              },
                              "id": "3500dd85-3826-65da-3eac-cf6b0413ec36"
                            }
