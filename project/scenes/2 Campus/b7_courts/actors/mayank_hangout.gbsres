                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: First\nweek's always\nweird.",
                      "You'll get used to\nit. Or I'll get\nused to you.",
                      "Mayank: I came\nhere because my\ncousin did.",
                      "Not a great\nreason. Turned out\nokay.",
                      "Mayank: Why did\nyou come here?"
                    ],
                    "avatarId": ""
                  },
                  "id": "74340723-760d-a52a-7f7e-a641b3b6b6b1"
                }
              ],
              "false": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: You didn't\nanswer yesterday.",
                      "About why you came\nhere.",
                      "Mayank: It's fine.\nNobody really\nknows.",
                      "We just end up\nsomewhere and make\nit ours.",
                      "Mayank: Hey. Glad\nit's you in room\n10."
                    ],
                    "avatarId": ""
