            "children": {
              "true": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: Maggi\nwith extra cheese.\nThis is fuel.",
                      "Champions eat\nthis.",
                      "Divyansh: I'm\ngoing to do\neverything this",
                      "year. Gym. Coding.\nGuitar. Startup.",
                      "Divyansh: ...I\nhaven't started\nany of them.",
                      "But I've planned\nall of them.\nThat's half."
                    ],
                    "avatarId": ""
                  },
                  "id": "52698384-8a1a-800e-7e2c-2d7301de2e7e"
                }
              ],
              "false": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: Okay\nreal talk. I talk\nbig because if I",
                      "say it out loud,\nmaybe it happens.",
                      "Divyansh: Back\nhome everyone says\nI'm all talk.",
                      "Maybe. But one day\nI'll walk the\nwalk.",
                      "Divyansh: When it\ncounts. You'll\nsee."
                    ],
                    "avatarId": ""
                  },
                  "id": "5eb1270f-ef37-14b8-d208-6e50ee0d5d2f"
                }
              ]
            },
