            "children": {
              "true": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Garvita: Race you\nto the pavilion!\n...No? Coward.",
                      "Garvita: I run\nbecause when I\nstop, I start",
                      "thinking. Running\nis cheaper than\ntherapy.",
                      "Garvita: Tomorrow\nI'm doing the AB2\nstairs.",
                      "All of them.\nTwice."
                    ],
                    "avatarId": ""
                  },
                  "id": "3a58cef6-873b-203b-c37b-8e29056dbaba"
                }
              ],
              "false": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Garvita: Back home\nI was 'the girl\nwho climbs",
                      "things'. Here I'm\njust me. It's\nnice.",
                      "Garvita: One day I\nwant to run so far\nnobody can call me",
                      "back.",
                      "Garvita: But\nalso...",
                      "it's nice when\nsomeone waits at\nthe finish."
                    ],
                    "avatarId": ""
                  },
                  "id": "e2128dcc-a698-8acb-9db1-66a2f9d87127"
                }
              ]
            },
            "id": "31eb45d5-569a-7051-22c8-2c5c40952046"
