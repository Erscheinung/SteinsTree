                    ],
                    "false": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Divyansh: Laugh\nnow.",
                            "When I'm famous,\nyou're not in the\ndocumentary."
                          ],
                          "avatarId": ""
                        },
                        "id": "af3b3bb3-6475-ee90-d02d-c51f55b3c22d"
                      }
                    ]
                  },
