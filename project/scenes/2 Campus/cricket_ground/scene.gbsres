                },
                {
                  "command": "EVENT_ACTOR_SET_DIRECTION",
                  "args": {
                    "actorId": "player",
                    "direction": {
                      "type": "direction",
                      "value": "up"
                    }
                  },
                  "id": "ecf5e2cd-72eb-03e5-fa18-c1a6fd020770"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: Field\nplacements.",
                      "Garvita deep\nmidwicket. Parag\nbowls. You, slip."
                    ],
                    "avatarId": ""
                  },
                  "id": "88f29b3f-3646-2dad-ecf6-7f6d963c2182"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "You: What's a\nslip?"
                    ],
                    "avatarId": ""
                  },
                  "id": "ebaeefd7-de51-7c3a-bf6d-32f78aeb56d8"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: Exactly\nwhat you'll do.\nStand there."
                    ],
                    "avatarId": ""
                  },
                  "id": "c3d2010f-f382-4db9-3c02-ed70f0728c16"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: Watch.\nFirst ball. Six.",
                      "Over the solar\npanels. Into AB3."
                    ],
                    "avatarId": ""
                  },
                  "id": "2364217c-85e6-6a7d-483a-c2ca3b42d26f"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: That's two\nhundred metres."
                    ],
                    "avatarId": ""
                  },
                  "id": "94a09d87-08dd-86cb-e027-bff5a0c32072"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: Two\nhundred and ONE.\nWrite it down."
                    ],
                    "avatarId": ""
                  },
                  "id": "c8f1ab24-bc5c-35c0-804b-90e1bfa098fb"
                },
                {
                  "command": "EVENT_SOUND_PLAY_EFFECT",
                  "args": {
                    "type": "crash",
                    "priority": "medium",
                    "pitch": 3,
                    "frequency": 400,
                    "duration": 0.2,
                    "wait": false,
                    "effect": 0
                  },
                  "id": "a5dd1ed2-aea0-fc9e-2a9f-932cc869d9eb"
                },
                {
                  "command": "EVENT_CAMERA_SHAKE",
                  "args": {
                    "time": 0.3,
                    "frames": 18,
                    "shakeDirection": "horizontal",
                    "magnitude": {
                      "type": "number",
                      "value": 3
                    }
                  },
                  "id": "51a79291-a00a-7e36-cd82-367fe2e8208e"
                },
                {
                  "command": "EVENT_ACTOR_MOVE_TO",
                  "args": {
                    "actorId": "d5550bdc-3246-5202-a9a0-6f75f83c81dd",
                    "x": {
                      "type": "number",
                      "value": 15
                    },
                    "y": {
                      "type": "number",
                      "value": 22
                    },
                    "collideWith": [],
                    "moveType": "horizontal"
                  },
                  "id": "1928b830-8059-df71-a0cc-8e6e5d48de77"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Parag bowls.",
                      "Divyansh swings\nwith his whole\nsoul."
                    ],
                    "avatarId": ""
                  },
                  "id": "e28d1c3c-00db-146a-2d17-3fa165a1f5e3"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The ball hits the\nstumps. The stumps\nfall over.",
                      "Divyansh does not\nmove."
                    ],
                    "avatarId": ""
                  },
                  "id": "a3faba8a-ba57-8e81-3ed7-a634f97e3128"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Divyansh: ...I was\ntesting the\nbowler."
                    ],
                    "avatarId": ""
                  },
                  "id": "2224e91f-3be6-6b84-1f0f-c436bf0a73a8"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Garvita: I\nsprinted all the\nway from midwicket",
                      "to laugh at you up\nclose."
                    ],
                    "avatarId": ""
                  },
                  "id": "65068832-c7a8-4f64-d8e6-dd491ecc5194"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Kanishk: Evidence\nlogged."
                    ],
                    "avatarId": ""
                  },
                  "id": "c3bd4f9f-24f3-d18b-1754-df0119ad5a67"
                },
                {
                  "command": "EVENT_CHOICE",
                  "args": {
                    "variable": "119",
                    "trueText": "Cheer Divyansh up",
                    "falseText": "Laugh along"
                  },
                  "id": "d6f25402-1cc8-760d-b987-ec06689028a8"
                },
                {
                  "command": "EVENT_IF",
                  "args": {
                    "condition": {
                      "type": "eq",
                      "valueA": {
                        "type": "variable",
                        "value": "119"
                      },
                      "valueB": {
                        "type": "number",
                        "value": 1
                      }
                    },
                    "__collapseElse": false
                  },
                  "children": {
                    "true": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "You: Next match.\nSeven. Over the\nDome."
                          ],
                          "avatarId": ""
                        },
                        "id": "89470e43-61be-d1a8-8f73-e8033db443b7"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Divyansh: SEE?\nSomeone believes\nin me."
                          ],
                          "avatarId": ""
                        },
                        "id": "f9b288c2-722d-a28c-edbd-85b6e95b51bc"
                      },
                      {
                        "command": "EVENT_VARIABLE_MATH",
