                {
                  "command": "EVENT_COMMENT",
                  "args": {
                    "text": "DAY 2 - CRICKET MATCH",
                    "__collapse": false
                  },
                  "id": "0a205ed1-345f-fc05-71e9-544a828744f8"
                },
                {
                  "command": "EVENT_ACTOR_SET_POSITION",
                  "args": {
                    "actorId": "player",
                    "x": {
                      "type": "number",
                      "value": 11
                    },
                    "y": {
