            "children": {
              "true": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Parag: See this\navenue? Perfect\ntest range.",
                      "Long, straight, no\nprofessors.",
                      "Parag: I fix\nthings.",
                      "Fans, phones, my\nroommate's love\nlife.",
                      "Okay, not that.",
                      "Parag: If it\nbreaks, I build it\nagain.",
                      "That's the whole\nphilosophy."
                    ],
                    "avatarId": ""
                  },
                  "id": "9b8bc816-d2b1-e8ad-8361-909875e033dd"
                }
              ],
              "false": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Parag: I failed my\nfirst robot in\nschool.",
                      "It caught fire.\nEveryone laughed.",
                      "Parag: I kept the\nburnt chip. It's\nin my wallet.",
                      "Reminds me to try\ntwice.",
                      "Parag: Things jam.\nPeople jam.",
                      "You clear it and\nkeep going."
                    ],
                    "avatarId": ""
                  },
                  "id": "758c2ef7-3a10-294b-386d-3f82adbbfb9b"
                }
              ]
            },
