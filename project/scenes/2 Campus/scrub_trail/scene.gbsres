                },
                {
                  "command": "EVENT_ACTOR_SET_DIRECTION",
                  "args": {
                    "actorId": "player",
                    "direction": {
                      "type": "direction",
                      "value": "right"
                    }
                  },
                  "id": "55fa9124-9caf-43d8-abb4-6d3dbe8ee71f"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: Chai.\nCutting.",
                      "Two rupees more\nthan last year.\nInflation is real."
                    ],
                    "avatarId": ""
                  },
                  "id": "bd426413-1549-04f3-9b4b-6b35a793e929"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: You know\nwhat I like about\nthis place?",
                      "Out here it's\nquiet enough to\nthink."
                    ],
                    "avatarId": ""
                  },
                  "id": "d9e409a6-e3f4-982d-200f-2e3a856688fc"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: So. Why\ndid you come here?",
                      "For real this\ntime."
                    ],
                    "avatarId": ""
                  },
                  "id": "9571ec93-9d60-2895-6915-8d1b7c5b1f22"
                },
                {
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "119",
                    "items": 3,
                    "cancelOnLastOption": false,
                    "cancelOnB": false,
                    "layout": "dialogue",
                    "option1": "Didn't clear IIT",
                    "option2": "Didn't know",
                    "option3": "To meet you lot"
                  },
                  "id": "4dd06f56-d07a-4c54-cc12-7e70937aeade"
                },
                {
                  "command": "EVENT_SWITCH",
                  "args": {
                    "variable": "119",
                    "choices": 3,
                    "__collapseElse": true,
                    "value0": {
                      "type": "number",
                      "value": 1
                    },
                    "value1": {
                      "type": "number",
                      "value": 2
                    },
                    "value2": {
                      "type": "number",
                      "value": 3
                    }
                  },
                  "children": {
                    "true0": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "You: IIT didn't\nhappen. Twelfth\nwas... a lot."
                          ],
                          "avatarId": ""
                        },
                        "id": "7af59849-ae55-ac49-1d3c-a2d6d50241a2"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Mayank: Yeah.",
                            "Everyone here has\nan IIT-shaped hole\nsomewhere.",
                            "We fill it with\nchai."
                          ],
                          "avatarId": ""
                        },
                        "id": "3b71a1c2-f8c5-1243-5b0e-0987214dc84e"
                      }
                    ],
                    "true1": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "You: Honestly? I\ndon't know. I just\nended up here."
                          ],
                          "avatarId": ""
                        },
                        "id": "e8773eee-7adb-212a-f7bc-fe146f7de87a"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Mayank: That's the\nmost honest answer\nanyone's given me."
                          ],
                          "avatarId": ""
                        },
                        "id": "a314413d-f996-a934-8370-db1cf28c3626"
                      }
                    ],
                    "true2": [
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "You: To meet you\nlot. Obviously."
                          ],
                          "avatarId": ""
                        },
                        "id": "15502ce5-3a36-936d-2c39-9b65360a99be"
                      },
                      {
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Mayank: Liar.\n...Thanks though."
                          ],
                          "avatarId": ""
                        },
                        "id": "ecdfbbde-fcd8-ab7f-61bc-e22b325922e2"
                      },
                      {
                        "command": "EVENT_VARIABLE_MATH",
                        "args": {
                          "vectorX": "122",
                          "operation": "add",
                          "other": "val",
                          "value": "1",
                          "minValue": "0",
                          "maxValue": "0",
                          "clamp": true
                        },
                        "id": "efee4c78-9b47-6254-cbb2-c8137ea85af8"
                      }
                    ],
                    "false": []
                  },
                  "id": "c335b62c-5b4b-0309-e46b-56110572cc75"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: My nani\nsays life isn't a\nline.",
                      "It's a circle. You\nend up where you\nstarted,",
                      "Mayank: but you're\ndifferent, so it's\na different place."
                    ],
                    "avatarId": ""
                  },
                  "id": "3a2b7268-9ec5-46c2-03af-41d546b4fd28"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: Deep,\nright?",
                      "She also says\ndon't eat Maggi at\n2 AM.",
                      "Ignored that one."
                    ],
                    "avatarId": ""
                  },
                  "id": "641fcf6b-f4e9-df55-1400-b3d14d081404"
                },
                {
                  "command": "EVENT_SOUND_PLAY_EFFECT",
                  "args": {
                    "type": "noise",
                    "priority": "medium",
                    "pitch": 1,
                    "frequency": 100,
                    "duration": 1.0,
                    "wait": false,
                    "effect": 0
                  },
                  "id": "5e44a36d-d48a-ec98-152d-182c99b88124"
                },
                {
                  "command": "EVENT_CAMERA_SHAKE",
                  "args": {
                    "time": 0.4,
                    "frames": 24,
                    "shakeDirection": "horizontal",
                    "magnitude": {
                      "type": "number",
                      "value": 1
                    }
                  },
                  "id": "4e591a60-9190-9dd4-e4bb-a5eece2a6200"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Far off, past the\nreservoir,\nsomething howls.",
                      "Not a dog. Not\nquite."
                    ],
                    "avatarId": ""
                  },
                  "id": "8100dc1d-7812-6987-62dd-8dfbfcb2637b"
                },
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Mayank: ...Let's\nhead back."
                    ],
                    "avatarId": ""
                  },
                  "id": "446a2684-7841-6c5c-ce09-658ca474937b"
                },
                {
