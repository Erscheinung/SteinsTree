                    "loop": true
                  },
                  "id": "6613b2d2-03c0-16a3-613e-7f630c901187"
                },
                {
                  "command": "EVENT_ACTOR_SET_POSITION",
                  "args": {
                    "actorId": "player",
                    "x": {
                      "type": "number",
