                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Anshuman: ...",
                      "Anshuman: You\nfound me. Most\npeople don't.",
                      "That's kind of the\npoint.",
                      "Anshuman: Peacocks\nsleep in these\ntrees.",
                      "If you're quiet\nenough you can\nhear them."
                    ],
                    "avatarId": ""
                  },
                  "id": "eb75f379-b74d-d8d8-dbbe-97df59bc5832"
                }
              ],
              "false": [
                {
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Anshuman: I used\nto hide in the\nlibrary at school.",
                      "Not from bullies.\nFrom noise.",
                      "Anshuman: Stealth\ngames are honest.",
                      "Stay in the\nshadow, nobody\ngets hurt.",
                      "Anshuman: Thanks\nfor walking out\nhere.",
                      "Even if you made\nnoise the whole\nway."
                    ],
                    "avatarId": ""
                  },
                  "id": "362d85e5-c83e-864c-6ba4-ed1ebd0d09f0"
